# Copy to .env and fill in what you have. Every key is optional except where noted;
# without a key the app runs on cached data and the coverage panel says what is unavailable.

# NASA Earthdata Login (required for SMAP, IMERG, HLS, ECOSTRESS, GRACE, GEDI, NLDAS via earthaccess/AppEEARS)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# or a bearer token from https://urs.earthdata.nasa.gov/profile
EARTHDATA_TOKEN=

# Cesium ion (world terrain + imagery). Without it the globe uses an ellipsoid and open imagery.
VITE_CESIUM_ION_TOKEN=

# USDA NASS QuickStats https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# USDA AMS MyMarketNews https://mymarketnews.ams.usda.gov/
AMS_API_KEY=

# OpenET https://etdata.org/
OPENET_API_KEY=

# Copernicus Climate Data Store (ERA5) https://cds.climate.copernicus.eu/
CDS_API_KEY=

# Google Earth Engine project (optional, AlphaEarth embeddings)
EE_PROJECT=

# Email alerts (optional). With none set, alerts are written to alerts/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
RESEND_API_KEY=

# Optional LLM for the SI Narrator (templates are used by default)
ANTHROPIC_API_KEY=

# Optional Google Maps / Photorealistic 3D Tiles ("Google mode" only)
VITE_GOOGLE_MAPS_KEY=

# Contact string sent in User-Agent to public APIs (Nominatim etc.)
FIELDSHIFT_USER_AGENT=FarmSmart/0.1 (Space Apps 2026)
